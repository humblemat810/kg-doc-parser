# Copy this file to `.env` and fill in real values locally.
# Do not commit real API keys or machine-specific paths.

GOOGLE_API_KEY="your-google-api-key"
FREE_KEY="your-google-api-key"
LANGSMITH_TRACING=false

# Optional file list inputs used by some test and batch flows.
# These can be relative or absolute paths to allow-list files.
ocr_file_list="allow_split_pages.txt"
split_raw_file_list="allow_split_pages.txt"
answer_export_list="unique_new_file_by_index.txt"

# Optional provider-backed PageIndex summary pass. It is disabled by default;
# when enabled, child summaries receive bounded direct-parent summary context.
KG_DOC_PARSER_PAGE_INDEX_HIERARCHICAL_SUMMARY_ENABLED=false

# Optional reasoning level for OpenAI-compatible chat providers.
# Leave empty to use the provider default; common values are none, low,
# medium, and high.
KG_DOC_PARSER_REASONING_EFFORT=
KG_DOC_OCR_REASONING_EFFORT=

# Optional local Bonsai/OpenAI-compatible vision OCR.
# KG_DOC_OCR_PROVIDER=bonsai
# KG_DOC_OCR_MODEL=Ternary-Bonsai-2-27B-PTQ1_0
# KG_DOC_OCR_BASE_URL=http://127.0.0.1:8001/v1
# KG_DOC_OCR_API_KEY_ENV=LLM_WIKI_LOCAL_MODEL_API_KEY

# Optional Docling OCR adapter (install Docling separately).
# KG_DOC_OCR_PROVIDER=docling
# KG_DOC_OCR_ENGINE=rapidocr
